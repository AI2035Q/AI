    <div class="cb-cost out" id="cbOutCost">-</div>
    <div class="cb-rate">&yen;6.3075 / 百万token</div>
  </div>
</div>

<div class="stats">
  <div class="stat"><div class="stat-label">API 调用次数</div><div class="stat-value" id="statCalls">-</div></div>
  <div class="stat"><div class="stat-label">缓存命中率</div><div class="stat-value green" id="statHitRate">-</div></div>
  <div class="stat"><div class="stat-label">总 Token</div><div class="stat-value" id="statTokens">-</div></div>
  <div class="stat"><div class="stat-label">总费用</div><div class="stat-value yuan" id="statCost">-</div></div>
  <div class="stat"><div class="stat-label">日均费用</div><div class="stat-value yuan" id="statAvg">-</div></div>
</div>
<div class="charts">
  <div class="box"><div class="box-title">每日费用趋势（绿=缓存命中 / 红=缓存未命中 / 蓝=输出）</div><canvas id="trendCanvas"></canvas><div id="trendTooltip"></div></div>
  <div class="box"><div class="box-title">费用构成分布</div><canvas id="pieCanvas"></canvas></div>
</div>
<div class="box">
  <div class="box-title">每日明细</div>
