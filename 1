  <div class="cb-card miss">
    <div class="cb-title miss">&#x1f4c8; 输入（缓存未命中）</div>
    <div class="cb-tokens" id="cbMissTokens">-</div>
    <div class="cb-cost miss" id="cbMissCost">-</div>
    <div class="cb-rate">&yen;3.1538 / 百万token</div>
