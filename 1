<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>Token 用量报告</title>
<style>
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:"Segoe UI","Microsoft YaHei",sans-serif;background:#0d1117;color:#c9d1d9;padding:20px}
h1{color:#58a6ff;font-size:22px;margin-bottom:4px}
.sub{color:#8b949e;font-size:12px;margin-bottom:18px}
.header{display:flex;gap:12px;align-items:center;flex-wrap:wrap;margin-bottom:20px;padding:14px;background:#161b22;border-radius:10px}
.btn-group{display:flex;gap:6px}
.btn{padding:7px 14px;background:#21262d;border:1px solid #30363d;color:#c9d1d9;border-radius:6px;cursor:pointer;font-size:13px;transition:all .15s}
.btn:hover{background:#30363d}
.btn.active{background:#238636;border-color:#238636;color:#fff}
.btn-refresh{padding:8px 18px;background:#1f6feb;border:1px solid #388bfd;color:#fff;border-radius:6px;cursor:pointer;font-size:14px;font-weight:600;transition:all .15s}
.btn-refresh:hover{background:#388bfd}
.btn-refresh:disabled{background:#21262d;border-color:#30363d;color:#484f58;cursor:wait}
.date-pick{display:flex;gap:8px;align-items:center}
.date-pick input{padding:6px 8px;background:#21262d;border:1px solid #30363d;color:#c9d1d9;border-radius:6px;font-size:12px;width:130px}
.date-pick button{padding:6px 14px;background:#238636;border:none;color:#fff;border-radius:6px;cursor:pointer;font-size:13px}
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(155px,1fr));gap:10px;margin-bottom:20px}
.stat{background:#161b22;border-radius:10px;padding:14px;border:1px solid #21262d}
.stat-label{color:#8b949e;font-size:11px;margin-bottom:4px}
.stat-value{font-size:22px;font-weight:600}
.yuan{color:#f0883e}
.green{color:#3fb950}
.blue{color:#58a6ff}
.red{color:#f85149}

/* 费用分布卡片 */
.cost-breakdown{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:20px}
.cb-card{background:#161b22;border-radius:10px;padding:16px;border:1px solid #21262d;text-align:center}
.cb-card.hit{border-top:3px solid #3fb950}
.cb-card.miss{border-top:3px solid #f85149}
.cb-card.out{border-top:3px solid #58a6ff}
.cb-title{font-size:13px;font-weight:600;margin-bottom:8px}
.cb-title.hit{color:#3fb950}
.cb-title.miss{color:#f85149}
.cb-title.out{color:#58a6ff}
.cb-tokens{color:#8b949e;font-size:12px;margin-bottom:4px}
.cb-cost{font-size:24px;font-weight:700}
.cb-cost.hit{color:#3fb950}
.cb-cost.miss{color:#f85149}
.cb-cost.out{color:#58a6ff}
.cb-rate{color:#484f58;font-size:11px;margin-top:4px}

.charts{display:grid;grid-template-columns:2fr 1fr;gap:20px;margin-bottom:20px}
@media(max-width:900px){.charts{grid-template-columns:1fr}.cost-breakdown{grid-template-columns:1fr}}
.box{background:#161b22;border-radius:10px;padding:18px;border:1px solid #21262d;position:relative}
.box-title{color:#58a6ff;font-size:15px;margin-bottom:12px}
#trendCanvas{width:100%;height:280px;cursor:crosshair;display:block}
#pieCanvas{width:100%;height:260px;display:block}
#trendTooltip{position:fixed;background:#21262d;border:1px solid #30363d;padding:10px 12px;border-radius:8px;font-size:12px;pointer-events:none;z-index:100;opacity:0;transition:opacity .15s;white-space:nowrap}
table{width:100%;border-collapse:collapse;font-size:13px;margin-top:12px}
th{background:#21262d;padding:9px 10px;text-align:left;color:#8b949e;font-weight:500}
td{padding:9px 10px;border-bottom:1px solid #21262d}
tr:hover td{background:#1c2128}
.refresh-bar{display:flex;align-items:center;gap:12px;font-size:12px;color:#8b949e;margin-bottom:16px}
#refreshStatus{color:#3fb950;opacity:0;transition:opacity .3s}
#refreshStatus.show{opacity:1}
#refreshError{color:#f85149;margin-left:8px;display:none}
.footer{color:#484f58;font-size:11px;margin-top:20px;padding-top:12px;border-top:1px solid #21262d}
</style>
</head>
