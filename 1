function cstDateStr(d){var y=d.getFullYear(),m=String(d.getMonth()+1).padStart(2,'0'),dd=String(d.getDate()).padStart(2,'0');return y+'-'+m+'-'+dd;}
function cstMonthStr(d){var y=d.getFullYear(),m=String(d.getMonth()+1).padStart(2,'0');return y+'-'+m;}
function addDays(d,n){var r=new Date(d);r.setDate(r.getDate()+n);return r;}
function fmtTok(n){if(n>=1e6)return(n/1e6).toFixed(2)+'M';if(n>=1e3)return(n/1e3).toFixed(1)+'K';return n.toString();}
function fmtRMB(n){return'\u00a5'+n.toFixed(4);}

var now=new Date();
var TODAY=cstDateStr(now),YESTERDAY=cstDateStr(addDays(now,-1)),TOMORROW=cstDateStr(addDays(now,1));
var THIS_MONTH=cstMonthStr(now),LAST_MONTH=cstMonthStr(new Date(now.getFullYear(),now.getMonth()-1,1));
var MONTH_START=THIS_MONTH+'-01',LAST_START=LAST_MONTH+'-01';

var currentRange='month',dailyData=[],trendListeners=[];

document.querySelectorAll('#btnGroup .btn').forEach(function(btn){
  btn.addEventListener('click',function(){
    document.querySelectorAll('#btnGroup .btn').forEach(function(b){b.classList.remove('active');});
    btn.classList.add('active');currentRange=btn.dataset.range;updateView();
  });
});

function refreshData(){
  var btn=document.getElementById('btnRefresh'),status=document.getElementById('refreshStatus');
  var err=document.getElementById('refreshError');
  btn.disabled=true;btn.textContent='刷新中...';err.style.display='none';status.classList.remove('show');
  fetch('/api/refresh',{method:'POST'}).then(function(r){
    if(!r.ok)throw new Error('HTTP '+r.status);
    return r.json();
  }).then(function(d){
    DATA=d;
    document.getElementById('genTime').textContent=DATA.generated||'';
    updateView();
    btn.disabled=false;btn.textContent='\u21bb 刷新数据';
    status.textContent='ok '+DATA.generated;status.classList.add('show');
    setTimeout(function(){status.classList.remove('show');},3000);
  }).catch(function(e){
    btn.disabled=false;btn.textContent='\u21bb 刷新数据';
    err.textContent='failed '+e.message;err.style.display='inline';
  });
}

function applyCustom(){
  var s=document.getElementById('ds').value,e=document.getElementById('de').value;
  if(!s||!e)return;
  document.querySelectorAll('#btnGroup .btn').forEach(function(b){b.classList.remove('active');});
  currentRange='custom:'+s+':'+e;updateView();
}
function nextDay(dStr){var d=new Date(dStr+'T00:00:00+08:00');d.setDate(d.getDate()+1);return cstDateStr(d);}
function getRange(){
  if(currentRange==='today')return{start:TODAY,end:TOMORROW};
  if(currentRange==='yesterday')return{start:YESTERDAY,end:TODAY};
  if(currentRange==='month')return{start:MONTH_START,end:null};
  if(currentRange==='lastmonth')return{start:LAST_START,end:MONTH_START};
  if(currentRange==='all')return{start:'2000-01-01',end:null};
  if(currentRange.startsWith('custom:')){var p=currentRange.slice(7).split(':');return{start:p[0],end:nextDay(p[1])};}
  return{start:'2000-01-01',end:null};
}
function inRange(day,r){if(day<r.start)return false;if(r.end&&day>=r.end)return false;return true;}

function updateView(){
  if(!DATA)return;
  var range=getRange();
  dailyData=[];
  var totalCalls=0,totalTokens=0,totalCost=0;
  var totalHit=0,totalMiss=0,totalOut=0;
  var totalCostCache=0,totalCostMiss=0,totalCostOut=0;

  for(var day in DATA.daily){
    if(!inRange(day,range))continue;
    var d=DATA.daily[day];
    dailyData.push(d);
    totalCalls+=d.calls;totalTokens+=d.total;totalCost+=d.cost;
    totalHit+=(d.cache_hit||0);totalMiss+=(d.cache_miss||0);totalOut+=d.out;
    totalCostCache+=(d.cost_cache||0);totalCostMiss+=(d.cost_miss||0);totalCostOut+=(d.cost_out||0);
  }

  var days=Math.max(dailyData.length,1);
  var totalInput=totalHit+totalMiss;
  var hitRate=totalInput>0?(totalHit/totalInput*100).toFixed(1):'0.0';

  // Top stats
  document.getElementById('statCalls').textContent=totalCalls.toLocaleString();
  document.getElementById('statHitRate').textContent=hitRate+'%';
  document.getElementById('statTokens').textContent=fmtTok(totalHit+totalMiss+totalOut);
  document.getElementById('statCost').textContent=fmtRMB(totalCost);
  document.getElementById('statAvg').textContent=fmtRMB(totalCost/days);

  // Cost breakdown cards
  document.getElementById('cbHitTokens').textContent=fmtTok(totalHit)+' tokens';
  document.getElementById('cbHitCost').textContent=fmtRMB(totalCostCache);
  document.getElementById('cbMissTokens').textContent=fmtTok(totalMiss)+' tokens';
  document.getElementById('cbMissCost').textContent=fmtRMB(totalCostMiss);
  document.getElementById('cbOutTokens').textContent=fmtTok(totalOut)+' tokens';
  document.getElementById('cbOutCost').textContent=fmtRMB(totalCostOut);

  // Subtitle
  var label;
  if(currentRange==='month')label='本月（'+THIS_MONTH+'）';
  else if(currentRange==='lastmonth')label='上月（'+LAST_MONTH+'）';
  else if(currentRange==='today')label='今日（'+TODAY+'）';
  else if(currentRange==='yesterday')label='昨日（'+YESTERDAY+'）';
  else if(currentRange==='all')label='全部历史';
  else label='自定义范围';
  document.getElementById('subtitle').textContent=label+' | DeepSeek V4 PRO 75%折扣 | '+days+'天 | 命中率'+hitRate+'%';

  drawTrendChart();drawPieChart();renderDailyTable();
}

function drawTrendChart(){
  var canvas=document.getElementById('trendCanvas'),ctx=canvas.getContext('2d'),rect=canvas.getBoundingClientRect();
  var dpr=window.devicePixelRatio||1;
  canvas.style.width=rect.width+'px';canvas.style.height=rect.height+'px';
  canvas.width=rect.width*dpr;canvas.height=rect.height*dpr;
  ctx.setTransform(dpr,0,0,dpr,0,0);

  trendListeners.forEach(function(l){canvas.removeEventListener(l[0],l[1]);});
  trendListeners=[];

  var W=rect.width,H=rect.height,pad={top:20,right:50,bottom:40,left:60};
  var w=W-pad.left-pad.right,h=H-pad.top-pad.bottom;
  ctx.clearRect(0,0,W,H);

  if(dailyData.length===0){return;}

  // Stacked bar: cache_hit cost + cache_miss cost + output cost
  var maxCost=Math.max.apply(null,dailyData.map(function(d){return d.cost;}))||0.01;
  var xStep=w/Math.max(dailyData.length,1);
  var barW=Math.max(xStep*0.6,4);

  // Grid lines
  ctx.strokeStyle='#21262d';ctx.lineWidth=1;
  for(var i=0;i<=4;i++){
    var y=pad.top+h*i/4;
    ctx.beginPath();ctx.moveTo(pad.left,y);ctx.lineTo(W-pad.right,y);ctx.stroke();
    ctx.fillStyle='#8b949e';ctx.font='10px sans-serif';ctx.textAlign='right';
    ctx.fillText('\u00a5'+(maxCost*(4-i)/4).toFixed(2),pad.left-6,y+3);
  }

  // Draw stacked bars
  dailyData.forEach(function(d,idx){
    var x=pad.left+idx*xStep+xStep*0.2;
    var cacheH=d.cost_cache/maxCost*h;
    var missH=d.cost_miss/maxCost*h;
    var outH=d.cost_out/maxCost*h;
    var base=pad.top+h;

    // Output (blue) - bottom
    ctx.fillStyle='rgba(88,166,255,0.7)';
    ctx.fillRect(x,base-outH,barW,outH);
    // Cache miss (red) - middle
    ctx.fillStyle='rgba(248,81,73,0.7)';
    ctx.fillRect(x,base-outH-missH,barW,missH);
    // Cache hit (green) - top
    ctx.fillStyle='rgba(63,185,80,0.7)';
    ctx.fillRect(x,base-outH-missH-cacheH,barW,cacheH);
  });

  // Legend
  ctx.fillStyle='rgba(63,185,80,0.7)';ctx.fillRect(W-180,6,12,12);
  ctx.fillStyle='#c9d1d9';ctx.font='11px sans-serif';ctx.textAlign='left';ctx.fillText('缓存命中',W-164,16);
  ctx.fillStyle='rgba(248,81,73,0.7)';ctx.fillRect(W-100,6,12,12);
  ctx.fillText('未命中',W-84,16);
  ctx.fillStyle='rgba(88,166,255,0.7)';ctx.fillRect(W-40,6,12,12);
  ctx.fillText('输出',W-24,16);

  // X labels
  ctx.fillStyle='#8b949e';ctx.font='10px sans-serif';ctx.textAlign='center';
  var step=Math.max(1,Math.ceil(dailyData.length/12));
  dailyData.forEach(function(d,i){if(i%step===0||i===dailyData.length-1)ctx.fillText(d.day.slice(5),pad.left+i*xStep+xStep*0.5,H-pad.bottom+15);});

  // Tooltip
  var onMove=function(e){
    var r=canvas.getBoundingClientRect(),idx=Math.floor((e.clientX-r.left-pad.left)/xStep);
    if(idx>=0&&idx<dailyData.length){
      var d=dailyData[idx],tip=document.getElementById('trendTooltip');
      tip.style.opacity='1';
      tip.style.left=Math.min(e.clientX+12,window.innerWidth-260)+'px';
      tip.style.top=Math.max(e.clientY-80,10)+'px';
      tip.innerHTML='<b>'+d.day+'</b><br>缓存命中: '+fmtTok(d.cache_hit)+' \u2192 '+fmtRMB(d.cost_cache)+'<br>未命中: '+fmtTok(d.cache_miss)+' \u2192 '+fmtRMB(d.cost_miss)+'<br>输出: '+fmtTok(d.out)+' \u2192 '+fmtRMB(d.cost_out)+'<br><b>合计: '+fmtRMB(d.cost)+'</b>';
    }
  };
  var offMove=function(){document.getElementById('trendTooltip').style.opacity='0';};
  canvas.addEventListener('mousemove',onMove);canvas.addEventListener('mouseleave',offMove);
  trendListeners.push(['mousemove',onMove],['mouseleave',offMove]);
}

function drawPieChart(){
  var canvas=document.getElementById('pieCanvas'),ctx=canvas.getContext('2d'),rect=canvas.getBoundingClientRect();
  var dpr=window.devicePixelRatio||1;
  canvas.style.width=rect.width+'px';canvas.style.height=rect.height+'px';
  canvas.width=rect.width*dpr;canvas.height=rect.height*dpr;
  ctx.setTransform(dpr,0,0,dpr,0,0);
  var W=rect.width,H=rect.height,cx=W/2,cy=H/2,r=Math.min(W,H)/2-44;
  ctx.clearRect(0,0,W,H);

  // Sum cost breakdown
  var totalCostCache=0,totalCostMiss=0,totalCostOut=0;
  dailyData.forEach(function(d){totalCostCache+=d.cost_cache||0;totalCostMiss+=d.cost_miss||0;totalCostOut+=d.cost_out||0;});
  var total=totalCostCache+totalCostMiss+totalCostOut;
  if(total===0)return;

  var slices=[
    {val:totalCostCache,color:'#3fb950',label:'缓存命中'},
    {val:totalCostMiss,color:'#f85149',label:'未命中'},
    {val:totalCostOut,color:'#58a6ff',label:'输出'}
  ];
  var angle=-Math.PI/2;
  slices.forEach(function(s){
    var a=s.val/total*Math.PI*2;
    ctx.beginPath();ctx.moveTo(cx,cy);ctx.arc(cx,cy,r,angle,angle+a);ctx.closePath();
    ctx.fillStyle=s.color;ctx.fill();
    ctx.strokeStyle='#161b22';ctx.lineWidth=2;ctx.stroke();
    angle+=a;
  });
  ctx.beginPath();ctx.arc(cx,cy,r*0.50,0,Math.PI*2);ctx.fillStyle='#161b22';ctx.fill();
  ctx.fillStyle='#8b949e';ctx.font='11px sans-serif';ctx.textAlign='center';ctx.fillText('总费用',cx,cy-2);
  ctx.fillStyle='#c9d1d9';ctx.font='14px sans-serif';ctx.fillText('\u00a5'+total.toFixed(4),cx,cy+14);

  // Legend
  ctx.font='11px sans-serif';var ly=18;
  slices.forEach(function(s){
    var pct=(s.val/total*100).toFixed(1);
    ctx.fillStyle=s.color;ctx.fillRect(10,ly-8,12,12);
    ctx.fillStyle='#c9d1d9';ctx.textAlign='left';
    ctx.fillText(s.label+'  '+pct+'%  '+fmtRMB(s.val),28,ly+1);
    ly+=20;
  });
}

function renderDailyTable(){
  var tbody=document.querySelector('#dailyTable');
  tbody.innerHTML='<tr><th>日期</th><th>调用</th><th>缓存命中</th><th>缓存未命中</th><th>输出</th><th>命中率</th><th>费用(元)</th></tr>';
  if(dailyData.length===0){tbody.innerHTML+='<tr><td colspan="7" style="text-align:center;color:#8b949e;padding:20px">无数据</td></tr>';return;}
  dailyData.forEach(function(d){
    var all=d.cache_hit+d.cache_miss,hr=all>0?(d.cache_hit/all*100).toFixed(1):'0.0',tr=document.createElement('tr');
    tr.innerHTML='<td>'+d.day+'</td>'
      +'<td>'+d.calls+'</td>'
      +'<td style="color:#3fb950">'+fmtTok(d.cache_hit)+'</td>'
      +'<td style="color:#f85149">'+fmtTok(d.cache_miss)+'</td>'
      +'<td style="color:#58a6ff">'+fmtTok(d.out)+'</td>'
      +'<td>'+hr+'%</td>'
      +'<td style="color:#f0883e">\u00a5'+d.cost.toFixed(4)+'</td>';
    tbody.appendChild(tr);
  });
}

